import "os"

id "test/cmaketest"

fromVer "1.0.0"

onBuild (ctx, proj, out) => {
	installDir, err := ctx.outputDir()
	if err != nil {
		out.addErr err
		return
	}

	c := cmake.new(ctx.SourceDir, ctx.SourceDir+"/_build", installDir)
	c.buildType "Release"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"

	err = c.configure()
	if err != nil {
		out.addErr err
		return
	}
	err = c.build()
	if err != nil {
		out.addErr err
		return
	}
	err = c.install()
	if err != nil {
		out.addErr err
		return
	}

	out.setMetadata "-lcmtadd"
}

onTest (ctx, proj, out) => {
	installDir, err := ctx.outputDir()
	if err != nil {
		out.addErr err
		return
	}

	// Build the test program in a fresh transient directory, decoupled
	// from ctx.SourceDir. Today SourceDir is os.MkdirTemp'd per Build,
	// so a nested testBuild would also be fresh; once source caching
	// lands SourceDir will be stable across runs and a fixed nested path
	// would inherit a stale CMakeCache.txt from a prior matrix/install.
	// Using os.mkdirTemp keeps onTest correct under both regimes.
	testSrc := ctx.SourceDir + "/tests"
	testBuild, err := os.mkdirTemp("", "cmtadd-testbuild-*")
	if err != nil {
		out.addErr err
		return
	}

	tc := cmake.new(testSrc, testBuild, testBuild+"/_out")
	tc.buildType "Release"
	tc.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	tc.use installDir

	err = tc.configure()
	if err != nil {
		out.addErr err
		return
	}
	err = tc.build()
	if err != nil {
		out.addErr err
		return
	}

	// Run the freshly-built test binary. A non-zero exit code surfaces
	// via lastErr and fails onTest.
	exec testBuild + "/cmtadd_check"
	if lastErr != nil {
		out.addErr lastErr
		return
	}

	err = os.writeFile(installDir+"/ontest.stamp", []byte("cmtadd_check passed"), 0o644)
	if err != nil {
		out.addErr err
	}
}
