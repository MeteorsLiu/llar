import "slices"

id "pnggroup/libpng"

fromVer "1.0.0"

onRequire (proj, deps) => {
	if slices.contains(target.options["zlib"], "commit") {
		deps.require "madler/zlib", "9f0f2d4f9f1f28be7e16d8bf3b4e9d4ada70aa9f"
	} else {
		deps.require "madler/zlib", "v1.2.11"
	}
}

onBuild ctx => {
	installDir := ctx.outputDir

	a := autotools.new(ctx.SourceDir, ctx.SourceDir+"/_build", installDir)

	// Inject zlib dependency via autotools.use
	for _, dep := range ctx.Proj.Deps {
		depDir := ctx.outputDir(dep)
		a.use depDir
	}

	a.configure
	a.build
	a.install

	ctx.setMetadata "-lpng"
}
